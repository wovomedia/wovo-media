# DORMANT: native/ci is not an Actions workflow directory. Owner must review
# default-branch dispatch visibility and Vercel isolation before activation.
name: WOVO manually signed TestFlight build
on:
  workflow_dispatch:
    inputs:
      reviewed_sha:
        description: Exact 40-character wovo-ios-build commit reviewed by the owner
        required: true
        type: string
      version:
        description: App Store version (must match the intended app record)
        required: true
        default: '1.0'
        type: string
      build:
        description: New, unused build number (1-9999; do not retry uncertain uploads blindly)
        required: true
        type: string
      operation:
        description: Validate by default; upload never invites testers or submits App Review
        required: true
        default: validate-only
        type: choice
        options: [validate-only, upload-to-testflight]
      acknowledgement:
        description: Type BUILD_REVIEWED_NATIVE_SOURCE after source, runner cost and signing review
        required: true
        type: string
      upload_acknowledgement:
        description: Only for upload, type UPLOAD_BUILD_ONLY
        required: false
        type: string
permissions:
  contents: read
concurrency:
  group: wovo-native-signing
  cancel-in-progress: false
jobs:
  signed-build:
    if: github.repository == 'wovomedia/wovo-media' && github.ref == 'refs/heads/wovo-ios-build' && github.event_name == 'workflow_dispatch' && vars.WOVO_IOS_SIGNING_ENABLED == 'true' && inputs.acknowledgement == 'BUILD_REVIEWED_NATIVE_SOURCE'
    environment: ios-internal-signing
    runs-on: macos-26
    timeout-minutes: 40
    steps:
      # Same immutable official action revisions reviewed for the simulator CI.
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          persist-credentials: false
          fetch-depth: 1
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: '22'
      - name: Install locked native dependencies without signing secrets
        working-directory: native
        run: npm ci --ignore-scripts --no-audit --no-fund
      - name: Verify, temporarily sign, validate and optionally upload
        working-directory: native
        env:
          WOVO_IOS_SIGNING_ENABLED: ${{ vars.WOVO_IOS_SIGNING_ENABLED }}
          WOVO_REVIEWED_SHA: ${{ inputs.reviewed_sha }}
          WOVO_RELEASE_ACK: ${{ inputs.acknowledgement }}
          WOVO_UPLOAD_ACK: ${{ inputs.upload_acknowledgement }}
          WOVO_RELEASE_OPERATION: ${{ inputs.operation }}
          WOVO_APP_VERSION: ${{ inputs.version }}
          WOVO_BUILD_NUMBER: ${{ inputs.build }}
          WOVO_APPLE_TEAM_ID: ${{ vars.WOVO_APPLE_TEAM_ID }}
          WOVO_ASC_KEY_ID: ${{ vars.WOVO_ASC_KEY_ID }}
          WOVO_ASC_ISSUER_ID: ${{ vars.WOVO_ASC_ISSUER_ID }}
          WOVO_P12_BASE64: ${{ secrets.WOVO_P12_BASE64 }}
          WOVO_P12_PASSWORD: ${{ secrets.WOVO_P12_PASSWORD }}
          WOVO_PROFILE_BASE64: ${{ secrets.WOVO_PROFILE_BASE64 }}
          WOVO_ASC_P8_BASE64: ${{ secrets.WOVO_ASC_P8_BASE64 }}
        run: node scripts/testflight-release.mjs
      # No artifact wildcard, IPA/keychain upload, public invitation, review or
      # provisioning command. The script's finally block cleans signing material.
      # SIGKILL/host failure still relies on GitHub destroying this fresh runner.
