{
  "purpose": "Explicit native-only source allowlist for owner-approved public upload. No signing material, web source, customer media, build products or dependencies.",
  "repositoryRootRelative": true,
  "files": [
    "native/.gitattributes",
    "native/.gitignore",
    "native/README.md",
    "native/public-source-manifest.json",
    "native/brand-receipt.json",
    "native/capacitor.config.json",
    "native/package.json",
    "native/package-lock.json",
    "native/www/index.html",
    "native/www/offline.html",
    "native/www/orbit.png",
    "native/www/shell.css",
    "native/tests/foundation.test.mjs",
    "native/tests/ci-upload.test.mjs",
    "native/tests/navigation-policy-tests.swift",
    "native/tests/download-policy-tests.swift",
    "native/tests/download.test.mjs",
    "native/tests/recognize-studio.swift",
    "native/tests/simulator-smoke.test.mjs",
    "native/scripts/check-xcode.mjs",
    "native/scripts/build-simulator.sh",
    "native/scripts/archive-device.sh",
    "native/scripts/smoke-simulator.mjs",
    "native/scripts/simulator-smoke-policy.mjs",
    "native/ci/github-ios-simulator.yml.example",
    "native/ci/github-ios-build.yml",
    "native/ci/vercel.no-deploy.json",
    "native/ci/ExportOptions.plist.example",
    "native/ios/.gitignore",
    "native/ios/debug.xcconfig",
    "native/ios/App/CapApp-SPM/.gitignore",
    "native/ios/App/CapApp-SPM/README.md",
    "native/ios/App/CapApp-SPM/Package.swift",
    "native/ios/App/CapApp-SPM/Sources/CapApp-SPM/CapApp-SPM.swift",
    "native/ios/App/App.xcodeproj/project.pbxproj",
    "native/ios/App/App.xcodeproj/project.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist",
    "native/ios/App/App.xcodeproj/xcshareddata/xcschemes/App.xcscheme",
    "native/ios/App/App/AppDelegate.swift",
    "native/ios/App/App/SceneDelegate.swift",
    "native/ios/App/App/WovoBridgeViewController.swift",
    "native/ios/App/App/WovoNavigationPolicy.swift",
    "native/ios/App/App/WovoDownloadPolicy.swift",
    "native/ios/App/App/WovoDownloadCoordinator.swift",
    "native/ios/App/App/Info.plist",
    "native/ios/App/App/Base.lproj/Main.storyboard",
    "native/ios/App/App/Base.lproj/LaunchScreen.storyboard",
    "native/ios/App/App/Assets.xcassets/Contents.json",
    "native/ios/App/App/Assets.xcassets/AppIcon.appiconset/Contents.json",
    "native/ios/App/App/Assets.xcassets/AppIcon.appiconset/AppIcon-512@2x.png",
    "native/ios/App/App/Assets.xcassets/WovoOrbit.imageset/Contents.json",
    "native/ios/App/App/Assets.xcassets/WovoOrbit.imageset/orbit.png"
  ],
  "upload": {
    "repository": "wovomedia/wovo-media",
    "newBranch": "wovo-ios-build",
    "firstCommitRequiresAllMappings": true,
    "mappings": [
      { "source": "native/ci/github-ios-build.yml", "destination": ".github/workflows/wovo-ios-build.yml" },
      { "source": "native/ci/vercel.no-deploy.json", "destination": "vercel.json" }
    ],
    "note": "Create the reviewed native-only tree and commit before exposing a new branch ref. Do not modify main/default, wovo-v2, productionBranch or existing refs. Native push may start the unsigned simulator workflow; root vercel.json disables Git deployments. No signing, credential upload or App Store action."
  },
  "workflow": {
    "source": "native/ci/github-ios-simulator.yml.example",
    "optionalApprovedDestination": ".github/workflows/wovo-ios-simulator.yml",
    "trigger": "workflow_dispatch only",
    "note": "Activating the template and running cloud compute are separate actions; inspect repo visibility, branch and billing first. No push trigger, signing or submission."
  }
}
